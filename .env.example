# Copy to .env and edit. Never commit the real .env.

PORT=8080

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite file lives.
DB_PATH=./data/afterdark.db

# Number of cluster workers. 0 or 1 = single process (use for `npm run dev`).
# "auto" = one worker per CPU core minus one.
CLUSTER=auto

# Set to 1 behind nginx/Cloudflare so rate limiting reads X-Forwarded-For.
TRUST_PROXY=0

# Comma-separated usernames granted admin powers on registration.
ADMIN_USERS=admin

# --- Ads ---------------------------------------------------------------------
# Ad tags need localStorage before they will serve a creative, and localStorage
# needs a real origin. Sandboxing the frame to an opaque origin blocks both, so
# banners silently never fill. Giving the frame `allow-same-origin` on OUR host
# would let ad script call the API as the signed-in reader, so instead the frame
# is served from a second host and gets an origin of its own.
#
# ADS_ORIGIN: absolute URL of that second host, e.g. https://ads.example.com.
# Unset means ads stay sandboxed and empty.
#
# A subdomain is the cleanest way to be that host: ads.yourdomain.com is a
# different ORIGIN to yourdomain.com, so the frame gets storage and fills, while
# same-origin script access is still refused. It works because the session
# cookie here is host-only — cookieOpts sets no `domain`, so nothing on the
# parent domain is ever sent to the subdomain. If you ever add `domain:` to
# those cookie options, this stops being safe.
#
# Point ads.yourdomain.com at an instance of this app running ADS_ONLY=1.
ADS_ORIGIN=
ADS_ONLY=0
# On the ads instance: which site may frame it (absolute URL, no trailing slash).
SITE_ORIGIN=

# Escape hatch for single-host deploys: allow ads same-origin so they fill.
# This lets ad script read the page and call /api as the logged-in user. Only
# set this if you have no second host and accept that.
ADS_ALLOW_SAME_ORIGIN=0

# Pop-under. Off by default; the format readers punish hardest.
ADS_POPUNDER=0

# Seconds the exit interstitial holds a reader before its Continue button arms.
# Every link that leaves the site passes through it. 0 disables the wait but
# still shows the panel; clamped at 15, past which an interstitial stops reading
# as a page loading and starts reading as a site holding you hostage.
ADS_EXIT_WAIT=5

# How often the same reader meets it.
#   once   (default) once per destination host per session
#   always every outbound click, no exceptions
# `once` still shows the advert to everyone passing through — it only drops the
# repeats, which is what spares the reader opening six links from one thread.
# That reader is the one who comes back to argue in the comments, and billing
# them thirty seconds for an afternoon is how you get an ad blocker installed.
ADS_EXIT_MODE=once

# --- Reader support ("buy me a coffee") --------------------------------------
# Three states, and the server picks whichever is configured:
#
#   neither set        the page renders and says payments are not open yet
#   SUPPORT_URL only   tiers become links to a payment page. No third-party
#                      script, so `script-src 'self'` is untouched. Works with
#                      a Razorpay Payment Page, Buy Me a Coffee, a UPI link —
#                      anything with a URL.
#   both RAZORPAY_*    full Checkout. The server creates the order, so the
#                      amount cannot be edited in the browser, and verifies the
#                      signature before marking anything paid.
#
# Setting the two Razorpay keys is what adds checkout.razorpay.com to the CSP.
# Leave them empty and the site's script-src stays exactly as it is.
#
# Note on Razorpay: it onboards merchants in India (and Malaysia) only, and
# wants an Indian business registration and bank account. If you cannot get an
# account, nothing here is wasted — SUPPORT_URL takes any payment page and is
# the mode the site ships in.
SUPPORT_ENABLED=1
# e.g. https://buymeacoffee.com/your-handle
SUPPORT_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Currency, and the tier amounts in its MAJOR unit (rupees, not paise).
SUPPORT_CURRENCY=INR
SUPPORT_TIERS=99,299,599

# --- Age assurance -----------------------------------------------------------
# self  = self-declared 18+ interstitial only (NOT legally sufficient in the 26+
#         US states and the UK that mandate "highly effective" age assurance)
# vendor = delegate to an age-assurance provider via AGE_VERIFY_URL
AGE_ASSURANCE_MODE=self
AGE_VERIFY_URL=
